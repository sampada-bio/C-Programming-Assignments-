
#include <stdio.h>
#include <string.h>

int main()
{
    char str1[100], str2[100];
    int choice;

    do
    {
        printf("\n1. Length");
        printf("\n2. Copy");
        printf("\n3. Concatenate");
        printf("\n4. Compare");
        printf("\n5. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter a string: ");
                scanf("%99s", str1);
                printf("Length = %lu", strlen(str1));
                break;

            case 2:
                printf("Enter a string: ");
                scanf("%99s", str1);
                strcpy(str2, str1);
                printf("Copied string = %s", str2);
                break;

            case 3:
                printf("Enter first string: ");
                scanf("%99s", str1);
                printf("Enter second string: ");
                scanf("%99s", str2);
                strcat(str1, str2);
                printf("Combined string = %s", str1);
                break;

            case 4:
                printf("Enter first string: ");
                scanf("%99s", str1);
                printf("Enter second string: ");
                scanf("%99s", str2);

                if(strcmp(str1, str2) == 0)
                    printf("Strings are equal");
                else
                    printf("Strings are not equal");
                break;

            case 5:
                printf("Exit");
                break;

            default:
                printf("Invalid choice");
        }

    } while(choice != 5);

    return 0;
}
