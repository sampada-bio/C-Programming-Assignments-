#include <stdio.h>
#include <stdlib.h>

int main()
{
    FILE *f1, *f2;
    char ch;
    int c;

    f1 = fopen("source.txt", "r");
    f2 = fopen("destination.txt", "w");

    if (f1 == NULL || f2 == NULL)
    {
        printf("File cannot be opened");
        return 1;
    }

    while ((ch = fgetc(f1)) != EOF)
    {
        fputc(ch, f2);
    }

    printf("File copied successfully");

    fclose(f1);
    fclose(f2);

    return 0;
}